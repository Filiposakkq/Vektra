<?xml version="1.0" encoding="utf-8"?>
<!-- The screen it opens over: drifts left and dims. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="280">
    <translate android:fromXDelta="0" android:toXDelta="-15%" />
    <alpha android:fromAlpha="1" android:toAlpha="0.4" />
</set>
