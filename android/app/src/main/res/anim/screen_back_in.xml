<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen underneath returns. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="260">
    <translate android:fromXDelta="-15%" android:toXDelta="0" />
    <alpha android:fromAlpha="0.4" android:toAlpha="1" />
</set>
