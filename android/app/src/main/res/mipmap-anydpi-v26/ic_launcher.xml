<?xml version="1.0" encoding="utf-8"?>
<!-- The knight sits in the icon's safe zone (the middle 66 of 108), whatever shape the launcher cuts. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@drawable/vektra_knight" android:inset="20%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/vektra_knight_mono" android:inset="20%" />
    </monochrome>
</adaptive-icon>
