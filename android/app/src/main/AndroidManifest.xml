<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The review screen loads finished games from Chess.com's public archive. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates: the app hands a new release's APK to Android's installer, which asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- To tell Chess.com's screens (activities) from its dialogs. -->
    <queries>
        <package android:name="com.chess" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Vektra">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:label="Review games" />

        <receiver
            android:name=".AppUpdater$InstallResult"
            android:exported="false" />

        <!-- Quick settings tile: hints in bot games on or off. -->
        <service
            android:name=".HintsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Vektra hints"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Reads the Chess.com app's board in bot games; it never taps or types. -->
        <service
            android:name=".VektraAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
